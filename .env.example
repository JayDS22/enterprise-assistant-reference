# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_RESPONSES_MODEL=gpt-4o-2024-11-20
OPENAI_JUDGE_MODEL=gpt-4o-2024-08-06

# Database (Neon Postgres)
DATABASE_URL=postgres://user:pass@host.neon.tech/db?sslmode=require

# JWT (jose verify). HS256 shared secret OR RS256 public key.
# For HS256:
JWT_SECRET=replace-with-base64-at-least-32-bytes
# For RS256 (if you switch): JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----..."
JWT_ISSUER=enterprise-assistant-reference
JWT_AUDIENCE=assistant.app

# Cost circuit breaker
COST_PER_CONVERSATION_USD=0.50
COST_PER_TENANT_DAY_USD=50.00

# Rate limit (token bucket per tenant)
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20

# OTel (optional; default is console + file exporter)
OTEL_SERVICE_NAME=enterprise-assistant-reference
OTEL_FILE_EXPORTER_PATH=.otel/traces.jsonl
